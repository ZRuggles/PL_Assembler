@page "/"
@rendermode InteractiveServer

<PageTitle>Assembler</PageTitle>

<h1>Type or upload ARM instructions</h1>

<InputTextArea @bind-Value="InputText" Class="form-control" Rows="10" Placeholder="Enter ARM instructions here..."/>

<InputFile OnChange="LoadFile" />

@if (isLoading)
{
    <p>Uploading...</p>
}
else if(UploadedFile == null)
{
    <p>No file uploaded.</p>
}
else 
{
    <p>Name: @UploadedFile.Name</p>
    <p>Size: @UploadedFile.Size bytes</p>
    <p>Type: @UploadedFile.ContentType</p>
    <p>Content: @InputText</p>
}

<button class="btn btn-primary mt-2" @onclick=HandleSubmit>Submit</button>
<button class="btn btn-outline mt-2" @onclick=HandleBinaryDownload>Download Binary.txt</button>
<button class="btn btn-outline mt-2" @onclick=HandleHexDownload>Download Hex.txt</button>
<button class="btn btn-outline mt-2" @onclick=HandleHexFlipDownload>Download Flipped_Hex.txt</button>
<button class="btn btn-secondary mt-2" @onclick=HandleByteDownload>Download kernel7.img</button>



@code 
{
    private string InputText { get; set; } = string.Empty;
    private IBrowserFile UploadedFile { get; set; } 
    private bool isLoading { get; set; } = false;
    // You can add methods to handle the input text, such as parsing or processing ARM instructions.
    // For example, you might want to add a method to handle form submission or button clicks.
    private List<Instruction> instructions = new List<Instruction>();
    [Inject] private IJSRuntime JSRuntime { get; set; }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        isLoading = true;

        try
        {
            UploadedFile = e.File;
            Console.WriteLine("File selected: " + UploadedFile.Name);

            using var stream = UploadedFile.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1 MB limit
            using var reader = new StreamReader(stream);
            InputText = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("File: {FileName} Error: {Error}",
                UploadedFile.Name, ex.Message);
        }
        isLoading = false;
    }

    private void HandleSubmit()
    {
        // Split InputText into lines
        string[] lines = InputText.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var line in lines)
        {
            Console.WriteLine("Line: " + line);
            Instruction instruction = Instruction.CreateInstruction(line);
            instructions.Add(instruction);
        }

        foreach (var i in instructions)
        {
            Console.WriteLine("Instruction: " + i.ToBinary());
        }
        Console.WriteLine("Total instructions: " + instructions.Count);
    }

    private async Task HandleBinaryDownload()
    {
        var content = string.Join("\n", instructions.Select(i => i.ToBinary()));

        await JSRuntime.InvokeVoidAsync("downloadTextFile", content, "binary.txt");
    }

    private async Task HandleHexDownload()
    {
        var content = string.Join("\n", instructions.Select(i => i.ToHex()));

        await JSRuntime.InvokeVoidAsync("downloadTextFile", content, "hex.txt");
    }

    private async Task HandleHexFlipDownload()
    {
        var content = string.Join("\n", instructions.Select(i => i.ToHexFlip()));
        await JSRuntime.InvokeVoidAsync("downloadTextFile", content, "flipped_hex.txt");
    }

    private async Task HandleByteDownload()
    {
        byte[] content = instructions
            .SelectMany(i => i.ToByteArray()) // Flatten all byte arrays
            .ToArray(); 
            Console.WriteLine("Total bytes: " + content);
        string base64 = Convert.ToBase64String(content);
        await JSRuntime.InvokeVoidAsync("downloadBinaryFile", base64, "kernel7.img");
    }
}